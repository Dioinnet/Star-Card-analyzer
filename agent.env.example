# ============================================================
# AI 估价助手 LLM 配置模板
# 使用方式（二选一）:
#   Windows:   copy agent.env.example agent.env
#   macOS/Linux: cp agent.env.example agent.env
# 然后编辑 agent.env，填入你的 LLM API 密钥，重启应用生效。
# 环境变量（$env:OPENAI_*）优先于本文件。
# 支持任何 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / GLM / OpenAI 等）。
# ============================================================

# 必填：你的 LLM API 密钥。填好后取消本行开头的 # 即可启用 AI 助手。
# OPENAI_API_KEY=sk-在这里填入你的key

# 接口地址（OpenAI 兼容）。注意看服务商文档：
#   - 文档给完整地址（如 https://api.deepseek.com 或 https://xxx.com/v1）就整段填
#   - 不确定时先看服务商的 /chat/completions 示例
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名（服务商账号下可用的模型，如 deepseek-chat / qwen-max / glm-4-flash 等）
AGENT_MODEL=deepseek-chat
